{
  "name": "react-map-gl-draw-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter @osm-editor-kit/react-map-gl-draw build",
    "test-run": "bun run --filter @osm-editor-kit/react-map-gl-draw test-run",
    "type-check": "bun run --filter '*' type-check",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format-check": "oxfmt -c oxfmt.config.mjs --check .",
    "check-exports": "bun run --filter @osm-editor-kit/react-map-gl-draw check-exports",
    "check": "bun run format-check && bun run lint-check && bun run type-check && bun run test-run && bun run build && bun run check-exports",
    "dev": "bun run --filter preview dev",
    "version-packages": "changeset version",
    "release": "bun run scripts/release.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.4.4"
}
